{
  "name": "voice-for-the-voiceless",
  "version": "0.1.0",
  "private": true,
  "description": "无声之声 · 帮人把话说出口的社交表达搭子（Even 眼镜/戒指 + 云 API）",
  "workspaces": [
    "shared",
    "backend",
    "glasses-app"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:glasses": "npm --workspace glasses-app run dev",
    "test": "npm --workspace backend test && npm --workspace glasses-app test",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p glasses-app/tsconfig.json",
    "demo:pack": "node scripts/demo-pack.mjs"
  }
}
