# 无声之声 backend 环境变量样例
# 复制为 backend/.env 后填入真实值（.env 已被 .gitignore 忽略，绝不提交）

# ---- LLM（OpenAI 兼容协议，换厂商只改这三行）----
# DeepSeek:   https://api.deepseek.com/v1        model: deepseek-v4-flash
# 火山方舟:    https://ark.cn-beijing.volces.com/api/v3   model: 控制台接入点 ID
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-turbo
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# DeepSeek V4 默认会思考；实时候选链路关闭思考以控制延迟。其他 provider 不支持时留空。
LLM_THINKING=disabled
# 超时后自动回退模板库（毫秒）
LLM_TIMEOUT_MS=2500

# ---- Agent 记忆（SQLite，以下可不配）----
# 短期会话转写的保留时长；长期行为记忆只保存成功说出的短句与场景
# MEMORY_SESSION_TTL_HOURS=24

# ---- TTS（msedge-tts，免密钥，以下均可不配）----
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_TIMEOUT_MS=6000

# ---- 服务 ----
# PORT=8787
# HOST=0.0.0.0
